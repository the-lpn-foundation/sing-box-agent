{
  "_note": "VLESS + Reality example inbound. Replace every REPLACE_WITH_* placeholder before use.",
  "_generate_keys": [
    "# 1. Generate the Reality keypair (server keeps PRIVATE, client uses PUBLIC):",
    "sing-box generate reality-keypair",
    "",
    "# 2. Generate a short_id (8 hex chars is typical; up to 16):",
    "openssl rand -hex 8",
    "",
    "# 3. Generate a UUID for each user:",
    "sing-box generate uuid",
    "",
    "# 4. Pick a `server_name` that your server can actually reach over TLS",
    "#    and looks plausible as a cover site (e.g. www.microsoft.com, www.lovelive-anime.jp).",
    "#    Verify it: curl -sI https://<server_name> | head -n1  -> expect 200/301/302."
  ],

  "log": {"level": "info"},

  "dns": {
    "servers": [
      {"tag": "google", "address": "tls://8.8.8.8"},
      {"tag": "local", "address": "223.5.5.5", "detour": "direct"}
    ],
    "rules": [
      {"outbound": "any", "server": "local"}
    ]
  },

  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality-in",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "name": "user1",
          "uuid": "REPLACE_WITH_GENERATED_UUID",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "www.microsoft.com",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "www.microsoft.com",
            "server_port": 443
          },
          "private_key": "REPLACE_WITH_REALITY_PRIVATE_KEY",
          "short_id": ["REPLACE_WITH_SHORT_ID"]
        }
      }
    }
  ],

  "outbounds": [
    {"type": "direct", "tag": "direct"}
  ],

  "route": {
    "rules": [
      {"protocol": "dns", "action": "hijack-dns"},
      {"ip_is_private": true, "action": "reject"}
    ]
  }
}
